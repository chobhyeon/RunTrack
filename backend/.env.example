# 데이터베이스
# 먼저 PostgreSQL에 runtrack DB와 접속 사용자를 생성하세요.
# user/password는 예시입니다. 실제 계정으로 바꾸고 비밀번호의 특수문자는 URL 인코딩하세요.
DATABASE_URL=postgresql://user:password@localhost:5432/runtrack

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT & 보안
# 아래 값은 예시입니다. 로컬에서 생성한 랜덤 값으로 교체하고 .env는 커밋하지 마세요.
# 생성 명령: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 키
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENWEATHER_API_KEY=your-openweather-api-key

# 환경
DEBUG=False
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
